# ==========================================
# Krova Agri - Example Configuration (replace placeholder values)
# ==========================================

# PostgreSQL database (with the pgvector extension)
DB_NAME=khmeragribot
DB_USER=hermes
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# Dedicated database for the future public bot. These values must not point to
# the pilot database above.
PROD_DB_NAME=krova_prod
PROD_DB_USER=krova_prod
PROD_DB_PASSWORD=your_separate_prod_db_password_here
PROD_DB_HOST=localhost
PROD_DB_PORT=5432

# Google Gemini inference
GEMINI_API_KEY=your_gemini_api_key_here
# Optional alias; leave blank when GEMINI_API_KEY is set.
GOOGLE_API_KEY=

# Optional Azure Foundry /openai/v1 endpoint for cross-provider inference.
# The production venv's parent .env is also read if it exists; process variables win.
AZURE_FOUNDRY_BASE_URL=
AZURE_FOUNDRY_API_KEY=
# Optional override when Azure credentials are stored in a separate .env file.
AZURE_FOUNDRY_ENV_FILE=

# Ordered provider:deployment routes. The next model is tried after a failed call.
# Keep Gemini first until task-specific evaluation supports changing the default.
KROVA_RESPONSE_MODELS=gemini:gemini-3.6-flash,azure:gpt-4o
KROVA_VISION_MODELS=gemini:gemini-3.6-flash,azure:gpt-4o
KROVA_TRANSCRIPTION_MODELS=gemini:gemini-3.6-flash

# Grounded web research is enabled by default for substantive agricultural questions.
# It uses Gemini's Google Search grounding even when Azure writes the final answer.
KROVA_WEB_RESEARCH_ENABLED=true
KROVA_WEB_SEARCH_MODEL=gemini-3.6-flash

# Optional botanical identification
PLANTNET_API_KEY=

# Telegram bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Separate token for the future public bot. Do not reuse the pilot bot token.
KROVA_PROD_TELEGRAM_BOT_TOKEN=your_future_public_bot_token_here
# Set this to your numeric Telegram user ID to enable admin notifications.
ADMIN_TELEGRAM_ID=0
TESTER_TELEGRAM_ID=999999999

# Internal REST API bearer token (generate a long random value in production).
KROVA_API_TOKEN=replace_with_a_long_random_api_token

# Access control and mode (public | pilot | maintenance)
ACCESS_MODE=pilot

# RAG paths
RAG_DROPZONE=./rag_dropzone
RAG_PROCESSED=./rag_processed
RAG_REJECTED=./rag_rejected
RAG_MAX_INGEST_BYTES=52428800
RAG_MAX_PDF_PAGES=100
RAG_MAX_EXTRACTED_CHARS=5000000
RAG_MAX_CHUNKS=500
MAX_IMAGE_BYTES=10485760
MAX_AUDIO_BYTES=5242880
MAX_IMAGE_PIXELS=20000000
MEDIA_CACHE_RETENTION_SECONDS=86400
